[sub_resource type="GDScript" id="GDScript_3e7fv"]
script/source = "extends Sprite2D
var s: int = 800
var d: int = 1000
@onready var anni: AnimatedSprite2D = $AnimatedSprite2D
var dir: Vector2
var final_pos: Vector2

func _ready() -> void:
	d = position.distance_to(final_pos)
	hide()
	s = d / 1.5

func _process(delta: float) -> void:
	if d > 0:
		position += dir * s * delta
		d -= s * delta
	else:
		show()
		if !anni.is_playing():
			anni.play(\"explosion\")
			anni.animation_finished.connect(func(): print(\"finished\"); queue_free())
"

