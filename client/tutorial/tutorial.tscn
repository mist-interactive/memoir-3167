[node name="Text" type="RichTextLabel" parent="Page6" unique_id=1904845988]
custom_minimum_size = Vector2(432, 256)
custom_maximum_size = Vector2(432, 256)
layout_mode = 0
offset_left = 48.0
offset_right = 560.0
offset_bottom = 256.0
theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("StyleBoxFlat_ik1hn")
bbcode_enabled = true
text = "[color=cyan]After playing a command card, we must follow this
sequence:[/color]
1. Announce which units we intend to move.
2. Move them, one at a time.
3. Attack, one at a time.

Turn ends.
"
autowrap_mode = 1

