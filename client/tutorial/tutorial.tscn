bbcode_enabled = true
text = "Memoir '67 is intentionally designed with simple
general mechanics.

[b]This tutorial will mostly focus on the general
mechanics.[/b] Most scenario-specific mechanics have
to do with terrain, which you can easily see
by hovering over them with your mouse."
autowrap_mode = 1

