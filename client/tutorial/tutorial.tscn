bbcode_enabled = true
text = "Each turn, you must play one [b]Comman card[/b] from
your hand.

The cards in your hand are called [color=green]section cards[/color].
They issue orders to units in certain sections of the
map, which are separated by the red vertical lines."
autowrap_mode = 1

[node name="Page6" type="Control" parent="." unique_id=1102722765]
visible = false
