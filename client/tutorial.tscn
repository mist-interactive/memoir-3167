theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("StyleBoxFlat_ik1hn")
text = "Your goal is to be the first to get a certain number of medals.
The number required varies from scenario to scenario, but
this one, NAME OF THE SCENARIO, requires 5.

You get medals by destroying enemy units."
