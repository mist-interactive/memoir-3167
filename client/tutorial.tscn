theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("StyleBoxFlat_ik1hn")
text = "After playing a comman card, we must follow this sequence:
1. Announce which units we intend to move. Left click
2. Move them, one at a time. Left click -> right click
3. Battle, one at a time. Left click -> right click
4. Draw a new comman card to end the turn. 

"
autowrap_mode = 1

