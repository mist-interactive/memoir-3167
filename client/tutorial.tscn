theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("StyleBoxFlat_ik1hn")
text = "Memoir '67 is intentionally designed with simple general
mechanics.

This tutorial will mostly focus on the general mechanics.
Most scenario-specific mechanics have to do with terrain,
which you can easily see by hovering over them with your
mouse."
autowrap_mode = 1

[node name="Page4" type="Control" parent="." unique_id=1379314264]
visible = false
