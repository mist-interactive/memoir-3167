theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("StyleBoxFlat_ik1hn")
text = "Each turn, you must play one Comman card from your hand.

The cards in your hand are called section cards.
They issue orders to units in certain sections of the
map, which are separated by the red vertical lines."
autowrap_mode = 1

[node name="Page6" type="Control" parent="." unique_id=1102722765]
